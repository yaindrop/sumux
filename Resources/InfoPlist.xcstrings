    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within sumux would like to use Bluetooth to discover passkeys and security keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sumux 内で実行中のプログラムが、パスキーとセキュリティキーを検出するために Bluetooth の使用を求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在素幕中运行的程序想要使用蓝牙来发现通行密钥和安全密钥。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within sumux would like to use your camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sumux 内で実行中のプログラムがカメラの使用を求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在素幕中运行的程序想要使用您的摄像头。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
